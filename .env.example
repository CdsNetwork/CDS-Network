# Copy to .env.local and fill in from the Supabase project settings (API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for inviting users and storing uploaded files.
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online (Intuit developer app, Keys & credentials). Server only.
# Sandbox and production use different keys. QBO_ENVIRONMENT is sandbox or production.
# QBO_REDIRECT_URI must match a redirect URI in the Intuit app exactly, for example
# https://<portal domain>/cds/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=
QBO_REDIRECT_URI=
