# Copy to .env.local and fill in from the Supabase project settings (API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for inviting users and storing uploaded files.
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online (Intuit developer app, Keys & credentials). Server only.
# Sandbox and production use different keys. QBO_ENVIRONMENT is sandbox or production.
# QBO_REDIRECT_URI must match a redirect URI in the Intuit app exactly, for example
# https://<portal domain>/cds/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=
QBO_REDIRECT_URI=

# ShipStation API V2 (ShipStation > Account > API Settings). Server only.
# SHIPSTATION_TEST_LABELS: labels are test labels (no charge, not shippable) unless this is
# false. FedEx and UPS refuse test labels; USPS accepts them.
# SHIPSTATION_WEBHOOK_TOKEN: optional. When set, the tracking webhook
# (https://<portal domain>/api/shipstation/webhook) must also send it in the
# x-cds-webhook-token header (a custom header on the ShipStation webhook). The webhook is
# always checked against ShipStation's RSA signature.
SHIPSTATION_API_KEY=
SHIPSTATION_TEST_LABELS=true
SHIPSTATION_WEBHOOK_TOKEN=

# Email intake (work request emails to dispatch@cds.direct). Server only.
# INTAKE_WEBHOOK_TOKEN: shared secret (at least 24 characters) the email feed sends to
# https://<portal domain>/api/intake/email as "Authorization: Bearer <token>". The webhook
# answers 503 while it is not set.
# ANTHROPIC_API_KEY: CDS's Anthropic API key for reading emails. Without it, intake uses
# pattern matching only and marks every draft low confidence.
# INTAKE_MODEL: optional, defaults to claude-sonnet-5-5.
INTAKE_WEBHOOK_TOKEN=
ANTHROPIC_API_KEY=
INTAKE_MODEL=
# Resend inbound feed (dispatch@ forwarded to intake@in.cds.direct): Resend webhook
# https://<portal domain>/api/intake/resend, event email.received. Answers 503 until both are set.
# RESEND_WEBHOOK_SECRET: that webhook's signing secret (whsec_...).
# RESEND_RECEIVING_API_KEY: a Resend API key that can read received emails.
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=

# Vercel cron (vercel.json): tracking is polled from ShipStation every 2 hours at
# /api/cron/shipstation-tracking. Vercel sends "Authorization: Bearer <CRON_SECRET>"; the
# route answers 401 while it is not set. Use a random string of at least 32 characters.
CRON_SECRET=
